# Official public YouTube Data API v3 key used for Research search and statistics.
# The API has a free quota. Repeated identical searches are cached locally.
YOUTUBE_API_KEY=
YOUTUBE_CACHE_TTL_MS=900000
YOUTUBE_CACHE_MAX_ENTRIES=100

# --- LLM / text generation ---------------------------------------------------
# OpenAI-compatible API root for chat-completions.
# llama.cpp and LocalAI commonly use http://127.0.0.1:8080/v1.
AI_TEXT_BASE_URL=http://127.0.0.1:8080/v1

# Optional for keyless local servers; required when the endpoint enforces auth.
AI_TEXT_API_KEY=

# Exact model ID accepted by POST /chat/completions.
AI_TEXT_MODEL=local-model

# Text request timeout in milliseconds. Slow local models may need more time.
AI_TIMEOUT_MS=120000

# --- Image generation --------------------------------------------------------
# OpenAI-compatible API root for POST /images/generations.
# This may be the same server as the LLM endpoint or a completely different one.
AI_IMAGE_BASE_URL=http://127.0.0.1:8080/v1

# Optional image-provider key. It is independent from AI_TEXT_API_KEY.
AI_IMAGE_API_KEY=

# Leave blank for text-only operation.
AI_IMAGE_MODEL=
AI_IMAGE_SIZE=1536x1024
AI_IMAGE_TIMEOUT_MS=300000

# Backward-compatible shared aliases. New installs should prefer the split
# AI_TEXT_* / AI_IMAGE_* settings above. If split values are absent, these are
# still accepted by the server.
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_API_KEY=

# Optional: HTTP port, defaults to 5000.
PORT=5000

# Optional: bind address, defaults to loopback. Do not set 0.0.0.0 without a
# trusted authentication and rate-limiting gateway. Local Settings is not a
# public secret-management endpoint.
HOST=127.0.0.1
